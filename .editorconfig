# EditorConfig for MMNext POS
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = crlf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj,sln,slnx}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.cs]
# --- .NET analyzer severity rules (source of truth) ---
dotnet_diagnostic.CA1822.severity = none
dotnet_diagnostic.CA1031.severity = none
dotnet_diagnostic.CA1806.severity = none

dotnet_diagnostic.IDISPOSABLE.severity = error
dotnet_diagnostic.IDISPOSABLE001.severity = error

dotnet_diagnostic.CS1591.severity = none
dotnet_diagnostic.CS8602.severity = error
dotnet_diagnostic.CS8603.severity = error
dotnet_diagnostic.CS8604.severity = none
dotnet_diagnostic.CS8618.severity = none
dotnet_diagnostic.CS8620.severity = error
dotnet_diagnostic.CS8625.severity = error

# --- C# code-style conventions (documented as source of truth; not enforced as format errors) ---
dotnet_style_operator_placement_when_wrapping = wrap_before:none
dotnet_style_predefined_type_for_locals_parameters_members = true:none
dotnet_style_predefined_type_for_locals_parameters_members_int_types = true:none
dotnet_style_object_initializer = true:none
dotnet_style_collection_initializer = true:none
dotnet_style_require_accessibility_modifiers = always:none
dotnet_style_readonly_field = true:none

csharp_style_var_for_built_in_types = false:none
csharp_style_var_when_type_is_apparent = false:none
csharp_style_var_elsewhere = false:none
csharp_style_namespace_declarations = file_scoped:none
csharp_style_pattern_matching_over_is_with_cast_check = true:none
csharp_style_pattern_matching_over_as_with_null_check = true:none
csharp_style_deconstructed_variable_declaration = true:none
csharp_style_expression_bodied_methods = false:none
csharp_style_expression_bodied_constructors = false:none
csharp_style_expression_bodied_operators = false:none
csharp_style_expression_bodied_properties = true:none
csharp_style_expression_bodied_indexers = true:none
csharp_style_expression_bodied_accessors = true:none

csharp_naming_style_fields_pascal_case.capitalization = pascal_case
csharp_naming_style_fields_pascal_case.required_prefix = _
csharp_naming_style_fields_pascal_case.required_suffix =
csharp_naming_rule_fields_pascal_case.symbols = field
csharp_naming_rule_fields_pascal_case.style = csharp_naming_style_fields_pascal_case

csharp_naming_style_private_fields_camel_case.capitalization = camel_case
csharp_naming_style_private_fields_camel_case.required_prefix = _
csharp_naming_rule_private_fields_camel_case.symbols = private_field
csharp_naming_rule_private_fields_camel_case.style = csharp_naming_style_private_fields_camel_case

csharp_naming_style_parameters_camel_case.capitalization = camel_case
csharp_naming_rule_parameters_camel_case.symbols = parameter
csharp_naming_rule_parameters_camel_case.style = csharp_naming_style_parameters_camel_case

csharp_naming_style_local_functions_pascal_case.capitalization = pascal_case
csharp_naming_rule_local_functions_pascal_case.symbols = local_function
csharp_naming_rule_local_functions_pascal_case.style = csharp_naming_style_local_functions_pascal_case

csharp_naming_style_private_static_fields_pascal_case.capitalization = pascal_case
csharp_naming_style_private_static_fields_pascal_case.required_prefix = _
csharp_naming_rule_private_static_fields_pascal_case.symbols = private_static_field
csharp_naming_rule_private_static_fields_pascal_case.style = csharp_naming_style_private_static_fields_pascal_case

csharp_style_namespace_declarations = file_scoped:none

# --- Generated code handling ---
[*.{Designer.cs,g.cs}]
generated_code = true
dotnet_diagnostic.CS1591.severity = none
dotnet_style_require_accessibility_modifiers = none
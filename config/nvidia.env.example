# Copy these settings to your local user environment or a secret manager.
# Never commit a real key or a password-bearing connection string.
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=replace-with-your-nvidia-api-key

# Optional: pin models after checking GET /v1/models in your own NVIDIA account.
# Leave blank to let the router discover compatible names at runtime.
NVIDIA_MODEL_PLANNER=
NVIDIA_MODEL_CODER=
NVIDIA_MODEL_REVIEWER=
NVIDIA_MODEL_FAST=
